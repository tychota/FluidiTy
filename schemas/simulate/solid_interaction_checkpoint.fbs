include "common.fbs";
include "plastic_solid_particle.fbs";

namespace fluidity.solid.v1;

struct Orientation {
  w:double;
  vector:fluidity.cache.v1.Vector3;
}

struct Pose {
  center:fluidity.cache.v1.Vector3;
  orientation:Orientation;
}

struct BodyHistory {
  body_id:ulong;
  mass:double;
  principal_inertia:fluidity.cache.v1.Vector3;
  pose:Pose;
  previous_pose:Pose;
  linear_velocity:fluidity.cache.v1.Vector3;
  angular_velocity:fluidity.cache.v1.Vector3;
  force:fluidity.cache.v1.Vector3;
  torque:fluidity.cache.v1.Vector3;
}

struct BladeSide {
  particle_id:ulong;
  blade_id:ulong;
  sign:int;
}

struct ElasticParticle {
  particle_id:ulong;
  body_id:ulong;
  sorted_position:fluidity.cache.v1.Vector3;
  position:fluidity.cache.v1.Vector3;
  mass:double;
  velocity:fluidity.cache.v1.Vector3;
  velocity_slopes:fluidity.cache.v1.Matrix3;
  reference_volume:double;
  deformation_gradient:fluidity.cache.v1.Matrix3;
}

table SolidInteractionCheckpoint {
  schema_version:uint = 1 (id:0);
  accepted_step:ulong (id:1);
  bodies:[BodyHistory] (required, id:2);
  sides:[BladeSide] (required, id:3);
  elastic_particles:[ElasticParticle] (id:4);
  liquid_state:[ubyte] (id:5, force_align:8);
  plastic_particles:[PlasticParticle] (id:6);
}

root_type SolidInteractionCheckpoint;
file_identifier "FLSI";
