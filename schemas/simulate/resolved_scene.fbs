include "common.fbs";
namespace fluidity.cache.v1;
enum FieldKind:ubyte { ParticleUnion = 0, AnalyticSphere = 1, HorizontalPlane = 2, IsolatedCovarianceDrop = 3 }
enum ObstacleKind:ubyte { None = 0, Halfspace = 1, Slab = 2, OpenTank = 3 }
enum UpstreamRole:ubyte { InitialParticles = 0, Source = 1, Obstacle = 2 }
enum LiquidEosLaw:ubyte { Hencky = 0, Tait = 1 }
table Material {
  density:double = 1000 (id:0);
  surface_tension:double (id:1);
  ambient_pressure:double (id:2);
  bulk_modulus:double = inf (id:3);
  target_divergence:double (id:4);
  friction:double (id:5);
  penetration_tolerance:double (id:6);
  dynamic_viscosity:double = null (id:7);
  reference_sound_speed:double = null (id:8);
  eos_law:LiquidEosLaw = null (id:9);
  drift_correction_time:double = null (id:10);
  drift_maximum_rate:double = null (id:11);
  cavity_atmospheric_absolute_pressure:double = null (id:12);
  cavity_birth_hydrostatic_gauge_pressure:double = null (id:13);
}
struct WhitewaterRampBounds { low:double; high:double; }
table WhitewaterCapture {
  source_grid_origin:fluidity.cache.v1.Vector3 (required, id:0);
  spacing_m:double (id:1);
  radius_m:double (id:2);
  kinetic:WhitewaterRampBounds (required, id:3);
  trapped_air:WhitewaterRampBounds (required, id:4);
  crest:WhitewaterRampBounds (required, id:5);
  trapped_air_weight:double (id:6);
  crest_weight:double (id:7);
}
table OceanBoundary {
  still_water_height_m:double (id:0);
  water_depth_m:double (id:1);
  wave_height_m:double (id:2);
  wave_period_s:double (id:3);
  gravity_m_per_s2:double (id:4);
  propagation_direction:Vector3 (required, id:5);
  phase_at_world_origin_rad:double (id:6);
  inlet_wall_x_m:double (id:7);
  inlet_interior_x_m:double (id:8);
  outlet_interior_x_m:double (id:9);
  outlet_wall_x_m:double (id:10);
  inlet_rate_per_s:double (id:11);
  outlet_rate_per_s:double (id:12);
  inlet_particle_spacing_m:double (id:13);
  inlet_low_z_m:double (id:14);
  inlet_high_z_m:double (id:15);
}
table StepOptions {
  energy_blend:double = 0.6 (id:0);
  maximum_step_duration:double = 0.01 (id:1);
  minimum_face_mass:double (id:2);
  mass_per_quantum:double = 9.094947017729282e-13 (id:3);
  momentum_per_quantum:double = 9.094947017729282e-13 (id:4);
  pressure_iterations:uint = 256 (id:5);
  motion_sample_intervals:uint (id:6);
  whitewater_capture:WhitewaterCapture (id:7);
  ocean_boundary:OceanBoundary (id:8);
}
table HorizontalPlane {
  surface_height_y:double (id:0);
}
table OpenTank {
  start_low_x:double (id:0);
  high_x:double (id:1);
  floor_y:double (id:2);
  low_z:double (id:3);
  high_z:double (id:4);
  piston_velocity_x:double (id:5);
}
table Field {
  kind:FieldKind (id:0);
  center:Vector3 (required, id:1);
  radius:double = 1 (id:2);
  horizontal_plane:HorizontalPlane (id:3);
  seed_covariance_scale:double = null (id:4);
}
table Obstacle {
  kind:ObstacleKind (id:0);
  normal:Vector3 (required, id:1);
  start_coordinate:double (id:2);
  half_width:double (id:3);
  velocity:Vector3 (required, id:4);
  open_tank:OpenTank (id:5);
}
table EmissionSource {
  ordinal:ulong (id:0);
  particles_per_second:double (id:1);
  position:Vector3 (required, id:2);
  jitter:Vector3 (required, id:3);
  particle_template:Particle (required, id:4);
}
table UpstreamContent {
  role:UpstreamRole (id:0);
  ordinal:ulong (id:1);
  byte_length:ulong (id:2);
  digest:Digest (required, id:3);
}
table ConstituentMaterial {
  substance_id:ulong (id:0);
  phase_id:ulong (id:1);
  density_kg_per_m3:double (id:2);
}
table LiquidPhasePair {
  phase_a:ulong (id:0);
  phase_b:ulong (id:1);
  surface_tension:double (id:2);
}
table ResolvedScene {
  schema_version:uint = 1 (id:0);
  byte_length:ulong (id:1);
  model_version:uint = 1 (id:2);
  backend:Backend (id:3);
  build_digest:Digest (required, id:4);
  world_origin:Vector3 (required, id:5);
  cell_width:double = 1 (id:6);
  random_seed:ulong (id:7);
  acceleration:Vector3 (required, id:8);
  material:Material (required, id:9);
  options:StepOptions (required, id:10);
  field:Field (required, id:11);
  obstacle:Obstacle (required, id:12);
  sources:[EmissionSource] (required, id:13);
  upstream:[UpstreamContent] (required, id:14);
  constituent_materials:[ConstituentMaterial] (id:15);
  liquid_phase_pairs:[LiquidPhasePair] (id:16);
}
root_type ResolvedScene;
file_identifier "FLRS";
file_extension "flrs";
