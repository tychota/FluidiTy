{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "${sourceDir}/out/conan/${presetName}/conan_toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "FLUIDITY_ENABLE_CUDA": false
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-debug-cpu",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release-cpu",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug-cpu",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release-cpu",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug-cpu",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release-cpu",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release-cuda",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FLUIDITY_ENABLE_CUDA": true,
        "CMAKE_CUDA_ARCHITECTURES": "86-real;89-real;120-real;120-virtual"
      }
    },
    {
      "name": "windows-debug-cuda",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FLUIDITY_ENABLE_CUDA": true,
        "CMAKE_CUDA_ARCHITECTURES": "86-real;89-real;120-real;120-virtual",
        "CMAKE_CUDA_RUNTIME_LIBRARY": "Shared"
      }
    },
    {
      "name": "windows-release-cuda",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FLUIDITY_ENABLE_CUDA": true,
        "CMAKE_CUDA_ARCHITECTURES": "86-real;89-real;120-real;120-virtual",
        "CMAKE_CUDA_RUNTIME_LIBRARY": "Shared"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-debug-cpu",
      "configurePreset": "macos-debug-cpu"
    },
    {
      "name": "macos-release-cpu",
      "configurePreset": "macos-release-cpu"
    },
    {
      "name": "linux-debug-cpu",
      "configurePreset": "linux-debug-cpu"
    },
    {
      "name": "linux-release-cpu",
      "configurePreset": "linux-release-cpu"
    },
    {
      "name": "windows-debug-cpu",
      "configurePreset": "windows-debug-cpu"
    },
    {
      "name": "windows-release-cpu",
      "configurePreset": "windows-release-cpu"
    },
    {
      "name": "linux-release-cuda",
      "configurePreset": "linux-release-cuda"
    },
    {
      "name": "windows-debug-cuda",
      "configurePreset": "windows-debug-cuda"
    },
    {
      "name": "windows-release-cuda",
      "configurePreset": "windows-release-cuda"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-debug-cpu",
      "inherits": "test-base",
      "configurePreset": "macos-debug-cpu"
    },
    {
      "name": "macos-release-cpu",
      "inherits": "test-base",
      "configurePreset": "macos-release-cpu"
    },
    {
      "name": "linux-debug-cpu",
      "inherits": "test-base",
      "configurePreset": "linux-debug-cpu"
    },
    {
      "name": "linux-release-cpu",
      "inherits": "test-base",
      "configurePreset": "linux-release-cpu"
    },
    {
      "name": "windows-debug-cpu",
      "inherits": "test-base",
      "configurePreset": "windows-debug-cpu"
    },
    {
      "name": "windows-release-cpu",
      "inherits": "test-base",
      "configurePreset": "windows-release-cpu"
    },
    {
      "name": "linux-release-cuda",
      "inherits": "test-base",
      "configurePreset": "linux-release-cuda"
    },
    {
      "name": "windows-debug-cuda",
      "inherits": "test-base",
      "configurePreset": "windows-debug-cuda"
    },
    {
      "name": "windows-release-cuda",
      "inherits": "test-base",
      "configurePreset": "windows-release-cuda"
    }
  ]
}
