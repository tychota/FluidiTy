import Fluidity.Pressure
import Mathlib.Logic.Relation
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Analysis.InnerProductSpace.Symmetric
import Mathlib.Tactic.Linarith

open scoped BigOperators
attribute [local instance] Classical.propDecidable

namespace Fluidity

/-- Finite oriented internal links. Zero conductance removes an edge from connectivity.
The anchor is the sum of nonnegative Dirichlet and compliance diagonals. -/
structure PressureGraph (n m : ℕ) where
  tail : Fin m → Fin n
  head : Fin m → Fin n
  conductance : Fin m → ℝ
  anchor : Fin n → ℝ
  conductance_nonneg : ∀ f, 0 ≤ conductance f
  anchor_nonneg : ∀ i, 0 ≤ anchor i

/-- Outward incidence: +1 at the tail, -1 at the head. -/
def PressureGraph.incidence {n m : ℕ} (g : PressureGraph n m) (i : Fin n) (f : Fin m) : ℝ :=
  (if i = g.tail f then 1 else 0) - (if i = g.head f then 1 else 0)

/-- Undirected reachability generated by actual strictly positive oriented edges. -/
def PressureGraph.Reachable {n m : ℕ} (g : PressureGraph n m) : Fin n → Fin n → Prop :=
  Relation.EqvGen (fun i j => ∃ f, 0 < g.conductance f ∧ g.tail f = i ∧ g.head f = j)

/-- A component is unanchored when every diagonal in it vanishes. -/
def PressureGraph.Unanchored {n m : ℕ} (g : PressureGraph n m) (i : Fin n) : Prop :=
  ∀ j, g.Reachable i j → g.anchor j = 0

/-- Constants on positive-edge components, zero on every anchored component. -/
def PressureGraph.ComponentConstants {n m : ℕ} (g : PressureGraph n m) (x : Fin n → ℝ) : Prop :=
  (∀ i j, g.Reachable i j → x i = x j) ∧ (∀ i, 0 < g.anchor i → x i = 0)

/-- The integrated RHS sums to zero separately on each unanchored component. -/
def PressureGraph.Compatible {n m : ℕ} (g : PressureGraph n m) (b : Fin n → ℝ) : Prop :=
  ∀ i, g.Unanchored i → ∑ j, (if g.Reachable i j then b j else 0) = 0

/-- Incidence transpose is the oriented pressure difference, including self-loops. -/
private theorem incidence_jump {n m : ℕ} (g : PressureGraph n m) (x : Fin n → ℝ) (f : Fin m) :
    (∑ i, g.incidence i f * x i) = x (g.tail f) - x (g.head f) := by
  simp [PressureGraph.incidence, sub_mul, Finset.sum_sub_distrib]

-- Vanishing nonnegative energy forces every positive edge and anchor contribution to vanish.
private theorem constants_of_zero_energy {n m : ℕ} (g : PressureGraph n m) (x : Fin n → ℝ)
    (zero : pressureQuadraticForm g.incidence g.conductance g.anchor x = 0) :
    g.ComponentConstants x := by
  rw [pressure_quadratic_form_eq] at zero
  have edgeNonneg : ∀ f, 0 ≤ g.conductance f * (∑ i, g.incidence i f * x i) ^ 2 :=
    fun f => mul_nonneg (g.conductance_nonneg f) (sq_nonneg _)
  have anchorNonneg : ∀ i, 0 ≤ g.anchor i * x i ^ 2 :=
    fun i => mul_nonneg (g.anchor_nonneg i) (sq_nonneg _)
  have sums := (add_eq_zero_iff_of_nonneg
    (Finset.sum_nonneg fun f _ => edgeNonneg f)
    (Finset.sum_nonneg fun i _ => anchorNonneg i)).mp zero
  have edges : ∀ f, 0 < g.conductance f → x (g.tail f) = x (g.head f) := by
    intro f positive
    have term := (Finset.sum_eq_zero_iff_of_nonneg (fun f _ => edgeNonneg f)).mp sums.1 f
      (Finset.mem_univ f)
    rw [incidence_jump] at term
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp ((mul_eq_zero.mp term).resolve_left (ne_of_gt positive)))
  constructor
  · intro i j reachable
    induction reachable with
    | rel i j edge =>
      obtain ⟨f, positive, rfl, rfl⟩ := edge
      exact edges f positive
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  · intro i positive
    have term := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => anchorNonneg i)).mp sums.2 i
      (Finset.mem_univ i)
    exact sq_eq_zero_iff.mp ((mul_eq_zero.mp term).resolve_left (ne_of_gt positive))

/-- The kernel of the actual integrated operator is exactly the constants on positive-edge
reachability classes, with zero value throughout every component containing a positive anchor.
Zero conductance edges do not connect cells; empty graphs and self-loops are allowed. -/
theorem pressure_kernel_eq_component_constants {n m : ℕ} (g : PressureGraph n m)
    (x : Fin n → ℝ) :
    (∀ i, pressureAction g.incidence g.conductance g.anchor x i = 0) ↔ g.ComponentConstants x := by
  constructor
  · intro kernel
    apply constants_of_zero_energy g x
    simp [pressureQuadraticForm, kernel]
  · intro constant i
    have edges : ∀ f, g.conductance f * (∑ j, g.incidence j f * x j) = 0 := by
      intro f
      by_cases positive : 0 < g.conductance f
      · rw [incidence_jump, constant.1 _ _ (Relation.EqvGen.rel _ _ ⟨f, positive, rfl, rfl⟩)]
        ring
      · rw [le_antisymm (le_of_not_gt positive) (g.conductance_nonneg f)]
        ring
    have anchor : g.anchor i * x i = 0 := by
      by_cases positive : 0 < g.anchor i
      · rw [constant.2 i positive, mul_zero]
      · rw [le_antisymm (le_of_not_gt positive) (g.anchor_nonneg i), zero_mul]
    simp only [pressureAction, mul_assoc, edges, mul_zero, Finset.sum_const_zero, anchor, add_zero]

/-- Restricting pressure to zero on pins meeting each unanchored component makes the integrated
quadratic form strictly positive for every nonzero vector. Anchored components need no pin. -/
theorem pressure_gauge_positive_definite {n m : ℕ} (g : PressureGraph n m)
    (pin : Fin n → Prop)
    (covers : ∀ i, g.Unanchored i → ∃ j, g.Reachable i j ∧ pin j)
    (x : Fin n → ℝ) (zeroPins : ∀ i, pin i → x i = 0) (nonzero : x ≠ 0) :
    0 < pressureQuadraticForm g.incidence g.conductance g.anchor x := by
  have nonnegative := pressure_psd g.incidence g.conductance g.anchor
    g.conductance_nonneg g.anchor_nonneg x
  by_contra notPositive
  have constant := constants_of_zero_energy g x (le_antisymm (le_of_not_gt notPositive) nonnegative)
  apply nonzero
  funext i
  by_contra nonzeroAt
  have unanchored : g.Unanchored i := by
    intro j reachable
    apply le_antisymm ?_ (g.anchor_nonneg j)
    apply le_of_not_gt
    intro positive
    exact nonzeroAt ((constant.1 i j reachable).trans (constant.2 j positive))
  obtain ⟨j, reachable, pinned⟩ := covers i unanchored
  exact nonzeroAt ((constant.1 i j reachable).trans (zeroPins j pinned))

#print axioms pressure_kernel_eq_component_constants
#print axioms pressure_gauge_positive_definite

-- Anchor vanishing propagates across the entire actual reachability class.
private theorem constant_zero_of_anchored {n m : ℕ} (g : PressureGraph n m) (x : Fin n → ℝ)
    (constant : g.ComponentConstants x) (i : Fin n) (anchored : ¬ g.Unanchored i) : x i = 0 := by
  by_contra nonzero
  apply anchored
  intro j reachable
  apply le_antisymm ?_ (g.anchor_nonneg j)
  apply le_of_not_gt
  intro positive
  exact nonzero ((constant.1 i j reachable).trans (constant.2 j positive))

private def componentSetoid {n m : ℕ} (g : PressureGraph n m) : Setoid (Fin n) where
  r := g.Reachable
  iseqv := Relation.EqvGen.is_equivalence _

-- Partition a dot product by actual reachability classes, not a supplied component partition.
private theorem compatible_orthogonal_constants {n m : ℕ} (g : PressureGraph n m)
    (b x : Fin n → ℝ) (compatible : g.Compatible b) (constant : g.ComponentConstants x) :
    ∑ i, x i * b i = 0 := by
  classical
  let component := Quotient.mk (componentSetoid g)
  let : Fintype (Quotient (componentSetoid g)) := Fintype.ofFinite _
  rw [← Finset.sum_fiberwise Finset.univ component (fun i => x i * b i)]
  apply Finset.sum_eq_zero
  intro c _
  induction c using Quotient.inductionOn with
  | h i =>
    have fiber : ∀ j, component j = component i ↔ g.Reachable i j := by
      intro j
      constructor
      · intro equal
        exact Relation.EqvGen.symm _ _ (Quotient.exact equal)
      · intro reachable
        exact Quotient.sound (Relation.EqvGen.symm _ _ reachable)
    have factor : (∑ j ∈ Finset.univ with component j = component i, x j * b j) =
        x i * (∑ j, if g.Reachable i j then b j else 0) := by
      rw [Finset.sum_filter, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      simp only [fiber]
      by_cases reachable : g.Reachable i j
      · simp only [reachable, ite_true, constant.1 i j reachable]
      · simp [reachable]
    rw [factor]
    by_cases unanchored : g.Unanchored i
    · rw [compatible i unanchored, mul_zero]
    · rw [constant_zero_of_anchored g x constant i unanchored, zero_mul]

-- The characteristic vector of each unanchored reachability class belongs to the actual kernel.
private theorem component_indicator_kernel {n m : ℕ} (g : PressureGraph n m)
    (i : Fin n) (unanchored : g.Unanchored i) :
    ∀ j, pressureAction g.incidence g.conductance g.anchor
      (fun k => if g.Reachable i k then 1 else 0) j = 0 := by
  apply (pressure_kernel_eq_component_constants g _).mpr
  constructor
  · intro j k reachable
    have equivalent : g.Reachable i j ↔ g.Reachable i k :=
      ⟨fun h => Relation.EqvGen.trans _ _ _ h reachable,
        fun h => Relation.EqvGen.trans _ _ _ h (Relation.EqvGen.symm _ _ reachable)⟩
    simp only [equivalent]
  · intro j positive
    have unreachable : ¬ g.Reachable i j := by
      intro reachable
      have := unanchored j reachable
      linarith
    simp [unreachable]

private noncomputable def pressureLinearMap {n m : ℕ} (g : PressureGraph n m) :
    EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin n) where
  toFun x := WithLp.toLp 2 (pressureAction g.incidence g.conductance g.anchor x)
  map_add' x y := by
    ext i
    simp [pressureAction, mul_add, Finset.sum_add_distrib]
    ring
  map_smul' c x := by
    ext i
    simp [pressureAction, Finset.mul_sum, mul_add, mul_assoc, mul_left_comm, mul_comm]

-- Finite-sum transposition proves symmetry for the same action used in the PSD pilot.
private theorem pressure_bilinear {n m : ℕ} (g : PressureGraph n m) (x y : Fin n → ℝ) :
    (∑ i, x i * pressureAction g.incidence g.conductance g.anchor y i) =
      (∑ f, g.conductance f * (∑ i, g.incidence i f * x i) * (∑ j, g.incidence j f * y j)) +
      ∑ i, g.anchor i * x i * y i := by
  calc
    _ = (∑ i, ∑ f, (g.conductance f * (∑ j, g.incidence j f * y j)) *
        (g.incidence i f * x i)) + ∑ i, g.anchor i * x i * y i := by
      simp only [pressureAction, mul_add, Finset.sum_add_distrib]
      congr 1
      · apply Finset.sum_congr rfl
        intro i _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro f _
        ring
      · apply Finset.sum_congr rfl
        intro i _
        ring
    _ = (∑ f, (g.conductance f * (∑ j, g.incidence j f * y j)) *
        (∑ i, g.incidence i f * x i)) + ∑ i, g.anchor i * x i * y i := by
      rw [Finset.sum_comm]
      simp only [Finset.mul_sum]
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro f _
      ring
private theorem pressureLinearMap_symmetric {n m : ℕ} (g : PressureGraph n m) :
    (pressureLinearMap g).IsSymmetric := by
  intro x y
  simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
  change (∑ i, y i * pressureAction g.incidence g.conductance g.anchor x i) =
    ∑ i, pressureAction g.incidence g.conductance g.anchor y i * x i
  simp_rw [mul_comm (pressureAction _ _ _ y _)]
  rw [pressure_bilinear, pressure_bilinear]
  congr 1 <;> apply Finset.sum_congr rfl <;> intro i _ <;> ring

/-- The original integrated system is solvable exactly when its RHS sums to zero on each
unanchored positive-edge component. This uses symmetric finite-dimensional range/kernel
orthogonality; the graph kernel characterization is proved, not assumed. -/
theorem pressure_solvable_iff_component_compatible {n m : ℕ} (g : PressureGraph n m)
    (b : Fin n → ℝ) :
    (∃ p, ∀ i, pressureAction g.incidence g.conductance g.anchor p i = b i) ↔ g.Compatible b := by
  classical
  let A := pressureLinearMap g
  let rhs : EuclideanSpace ℝ (Fin n) := WithLp.toLp 2 b
  have rangeKernel : (LinearMap.ker A)ᗮ = LinearMap.range A := by
    rw [← (pressureLinearMap_symmetric g).orthogonal_range]
    exact (LinearMap.range A).orthogonal_orthogonal
  have rangeIff : (∃ p, ∀ i, pressureAction g.incidence g.conductance g.anchor p i = b i) ↔
      rhs ∈ LinearMap.range A := by
    constructor
    · rintro ⟨p, solves⟩
      refine ⟨WithLp.toLp 2 p, ?_⟩
      ext i
      exact solves i
    · rintro ⟨p, solves⟩
      refine ⟨fun i => p i, ?_⟩
      intro i
      exact congrArg (fun x : EuclideanSpace ℝ (Fin n) => x i) solves
  rw [rangeIff, ← rangeKernel, Submodule.mem_orthogonal]
  constructor
  · intro orthogonal i unanchored
    let indicator : EuclideanSpace ℝ (Fin n) :=
      WithLp.toLp 2 (fun j => if g.Reachable i j then 1 else 0)
    have kernel : indicator ∈ LinearMap.ker A := by
      apply LinearMap.mem_ker.mpr
      ext j
      exact component_indicator_kernel g i unanchored j
    have zero := orthogonal indicator kernel
    simpa [PiLp.inner_apply, RCLike.inner_apply, indicator, rhs, mul_ite] using zero
  · intro compatible x kernel
    have actionZero : ∀ i, pressureAction g.incidence g.conductance g.anchor x i = 0 := by
      intro i
      exact congrArg (fun y : EuclideanSpace ℝ (Fin n) => y i) (LinearMap.mem_ker.mp kernel)
    have zero := compatible_orthogonal_constants g b x compatible
      ((pressure_kernel_eq_component_constants g x).mp actionZero)
    simpa [PiLp.inner_apply, RCLike.inner_apply, rhs, mul_comm] using zero

#print axioms pressure_solvable_iff_component_compatible

end Fluidity
